# Data and artifacts
data/videos/*
data/annotation_packages/*
data/logo_templates/*
weights/*.pt
weights/*.pth
weights/*.onnx
!data/**/.gitkeep
!weights/.gitkeep
!weights/README.md

# IMPORTANT: keep config / registry files in git even though their parent dirs
# are ignored. brands.yaml is the master brand registry — without it the pipeline
# crashes. Example meta YAMLs are documentation.
!data/logo_templates/brands.yaml
!data/videos/match.meta.example.yaml
!data/videos/match.meta.away.example.yaml

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/
*-checkpoint.ipynb

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

